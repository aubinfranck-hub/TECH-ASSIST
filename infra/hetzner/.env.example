POSTGRES_DB=techassist
POSTGRES_USER=techassist
# Alphanumérique uniquement (pas de @ : / # % espace...) : ce mot de passe est
# interpolé tel quel dans une URL de connexion (DATABASE_URL) plus bas, un
# caractère spécial la casserait. Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# 32 octets encodés en base64, ex. : openssl rand -base64 32
SESSION_SECRETS_KEY=CHANGE_ME_32_BYTES_BASE64
GEMINI_API_KEY=
# Pas encore de nom de domaine : '*' autorise tout appelant. À restreindre
# à https://<domaine> dès qu'un nom de domaine est configuré (voir Caddyfile).
CORS_ORIGIN=*
# Remplacer par l'IP publique du serveur (ou le domaine une fois configuré).
RUSTDESK_ID_SERVER=CHANGE_ME_SERVER_IP
RUSTDESK_RELAY_SERVER=CHANGE_ME_SERVER_IP
RUSTDESK_PUBLIC_KEY=
RUSTDESK_RELAY_HOST=CHANGE_ME_SERVER_IP
