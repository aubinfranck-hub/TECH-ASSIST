# Copier en .env et renseigner les vraies valeurs. Ne jamais committer .env (voir RS-10).

# --- API ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (RF-32 / L1)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tech_assist

# Session admin / technicien
JWT_SECRET=change-me-in-production

# Chiffrement au repos des secrets de session (RS-10) — 32 octets en base64.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRETS_KEY=

# Lot L2 — serveur RustDesk auto-hébergé (décision D1, voir infra/rustdesk/).
# ID_SERVER/RELAY_SERVER : domaine public du hbbs/hbbr. PUBLIC_KEY : contenu
# de data/id_ed25519.pub généré au premier démarrage du conteneur hbbs.
RUSTDESK_ID_SERVER=
RUSTDESK_RELAY_SERVER=
RUSTDESK_PUBLIC_KEY=

# Diagnostic IA (RF-34) et assistant en ligne de l'agent (questions Office/Windows, formation, capture d'écran) — optionnel :
# sans clé, le moteur local de secours est utilisé et l'assistant répond « indisponible » (l'agent propose alors un technicien).
GEMINI_API_KEY=
# Modèle Gemini de l'assistant (défaut : gemini-2.0-flash)
GEMINI_MODEL=

# Apprentissage (D15) : quand l'agent ne connaît pas un cas, une IA compose un plan (à partir d'un catalogue fermé d'opérations),
# le serveur le mémorise et ne rappelle plus l'IA pour ce cas. Clés en variables d'environnement UNIQUEMENT (jamais dans le code).
# Ordre d'essai des IA (défaut : deepseek,gemini,claude) ; une IA absente de la liste ou sans clé est ignorée.
LEARNING_PROVIDERS=deepseek,gemini,claude
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GEMINI_API_KEY (voir plus haut) ; modèle propre à l'apprentissage : LEARNING_GEMINI_MODEL (sinon GEMINI_MODEL)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Essais d'IA par demande (1 à 3) et plafonds de coût
# LEARNING_MAX_ATTEMPTS=3
# LEARNING_MAX_AI_PER_SESSION=6
# LEARNING_MAX_AI_PER_INSTALL_DAY=15
# LEARNING_MAX_AI_PER_DAY=600
# Nombre de postes différents qui doivent confirmer « c'est réglé » avant qu'une procédure devienne « de confiance » (défaut 2)
# LEARNING_PROMOTE_AFTER=2

# Techniciens partenaires (D16) : session « viewer » = durée gratuite, puis le prix de la formule viewer_session (500 FCFA, modifiable en admin)
# VIEWER_FREE_SECONDS=180
# Délai pour payer après la durée gratuite avant la coupure de la session
# VIEWER_GRACE_SECONDS=60
# Sessions gratuites par partenaire et par jour
# VIEWER_MAX_FREE_PER_DAY=10
# Adresses (séparées par des virgules) prévenues d'une nouvelle demande de compte partenaire : TECH_ALERT_EMAILS

# Mobile Money (D3 — agrégateur non choisi) : en attendant, confirmation manuelle par un technicien/admin (RF-03, provisoire)
MOBILE_MONEY_AGGREGATOR=
MOBILE_MONEY_WEBHOOK_SECRET=

# Application (D9) : codes de vérification par e-mail. Obligatoire en production.
# Sans SMTP en développement, le code s'affiche dans la console de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tech Assist <no-reply@exemple.com>"

# Agent IA (D9) : mettre à true quand l'agent est déployé ; sinon les demandes « IA »
# sont servies par un technicien.
AI_AGENT_ENABLED=false

# Passage de main : les techniciens de permanence sont prévenus quand un client demande un technicien.
# Notifications du téléphone (Web Push) : node -e "console.log(require('web-push').generateVAPIDKeys())" dans apps/api
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.com
# Adresses qui reçoivent toujours l'alerte par email (séparées par des virgules) ; nécessite SMTP
TECH_ALERT_EMAILS=
# Webhook appelé à chaque demande de technicien (facultatif)
ALERT_WEBHOOK_URL=

# Web
VITE_API_BASE_URL=http://localhost:4000
# Liens de téléchargement de l'application (laisser vides tant qu'elle n'est pas publiée)
VITE_APP_WINDOWS_URL=
VITE_APP_ANDROID_URL=

# Base de pannes du technicien : nombre maximal de fiches rédigées par l'IA par jour (défaut 100).
# Les clés DEEPSEEK_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY (ci-dessus) servent aussi à enrichir cette base.
# PANNES_MAX_AI_PER_DAY=100

# Voix de l'assistant (lecture à voix haute des réponses de l'IA) : Google Cloud Text-to-Speech, voix neuronales Neural2.
# Activer l'API « Cloud Text-to-Speech » pour cette clé dans Google Cloud. Sans clé dédiée, GEMINI_API_KEY est essayée ; sans aucune
# clé, le site et l'agent lisent avec la voix du navigateur.
# GOOGLE_TTS_API_KEY=
# Voix française (défaut fr-FR-Chirp3-HD-Aoede, la plus naturelle ; autres : fr-FR-Chirp3-HD-Charon (masculine), fr-FR-Neural2-A/B en repli)
# GOOGLE_TTS_VOICE=fr-FR-Chirp3-HD-Aoede
