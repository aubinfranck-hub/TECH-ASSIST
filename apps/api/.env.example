
# Paiement automatique (Mobile Money via le prestataire, ex. GECO) — voir docs/decisions.md D11
# Secret partagé : le prestataire signe chaque notification (HMAC-SHA256 hex du corps, en-tête X-Signature).
PAYMENT_WEBHOOK_SECRET=
# Modèle du lien de paiement ; variables : {orderId} {amount} {email}
PAYMENT_LINK_TEMPLATE=
PAYMENT_PROVIDER=geco
