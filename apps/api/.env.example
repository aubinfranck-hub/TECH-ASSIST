
# Paiement automatique Jèko (Wave, Orange, MTN, Moov, Djamo) — voir docs/decisions.md D11
# Clés : Dashboard Jèko Business. Secret webhook : Réglages > API & Webhooks. Créer une boutique dédiée.
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
PAYMENT_WEBHOOK_SECRET=
# Adresse publique du site (pages de retour après paiement)
PUBLIC_WEB_URL=

# Lancement gratuit : true = toute assistance est offerte, rien n'est facturé (à retirer pour activer les forfaits)
FREE_LAUNCH=

# EMAIL_VERIFICATION=off : l'adresse est enregistrée sans code envoyé par email (lancement gratuit)
EMAIL_VERIFICATION=
